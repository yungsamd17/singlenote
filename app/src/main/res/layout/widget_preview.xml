<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_preview_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="@color/widget_preview_accent" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_preview_note" android:textColor="@color/widget_preview_text"
        android:textSize="16sp" android:maxLines="2" />
</LinearLayout>
