<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- On-demand only: public release notes (changelog) and update checks.
        No analytics, no tracking; see the Privacy Policy in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No cloud backup: the Room DB and DataStore prefs are plaintext,
        so nothing is copied to Drive. Uninstalling deletes everything;
        see the Privacy Policy in the app. -->
    <application
        android:name=".SinglenoteApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Singlenote"
        android:usesCleartextTraffic="false">

        <!-- Portrait on phones for 1.0.0. Android 16 (targetSdk 36) ignores
            orientation and resizability restrictions on screens 600dp and
            wider, so tablets and unfolded foldables rotate regardless; full
            landscape/large-screen layouts stay post-1.0.0. Edge-to-edge
            adjustResize supplies animated keyboard insets to the editor's
            imePadding. http:// links still render: LinkedText only
            displays them, never fetches. -->
        <activity
            android:configChanges="locale|layoutDirection"
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">

        </activity>

        <activity-alias android:name=".launcher.Default" android:targetActivity=".MainActivity"
            android:enabled="true" android:exported="true"
            android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:label="${appLabel}">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Dynamic" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_dynamic" android:roundIcon="@mipmap/ic_launcher_dynamic" android:label="${appLabel}">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.AccentDefault" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_accentdefault" android:roundIcon="@mipmap/ic_launcher_accentdefault" android:label="${appLabel}">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Blue" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_blue" android:roundIcon="@mipmap/ic_launcher_blue" android:label="${appLabel}">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Teal" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_teal" android:roundIcon="@mipmap/ic_launcher_teal" android:label="${appLabel}">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Green" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_green" android:roundIcon="@mipmap/ic_launcher_green" android:label="${appLabel}">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Orange" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_orange" android:roundIcon="@mipmap/ic_launcher_orange" android:label="${appLabel}">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Pink" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_pink" android:roundIcon="@mipmap/ic_launcher_pink" android:label="${appLabel}">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity
            android:name=".widget.WidgetConfigurationActivity"
            android:exported="true"
            android:theme="@style/Theme.Singlenote">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.SinglenoteWidgetReceiver"
            android:exported="false"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/singlenote_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NoteChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.yungsamd17.singlenote.NOTE_UPDATED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notify.PinActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.PinBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- App updates also wipe notifications: re-post the pin
                    without waiting for the next app open. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tile.NoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
    </application>

</manifest>
