<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- On-demand only: public release notes (changelog) and update checks.
        No analytics, no tracking; see the Privacy Policy in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No cloud backup: the Room DB and DataStore prefs are plaintext,
        so nothing is copied to Drive. Uninstalling deletes everything;
        see the Privacy Policy in the app. -->
    <application
        android:name=".SinglenoteApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Singlenote"
        android:usesCleartextTraffic="false">

        <!-- Temporary portrait lock (was android:screenOrientation="portrait"
            before rotation support): forces vertical orientation until the
            landscape layout is fixed. adjustNothing is kept on purpose:
            the editor's keyboard glide relies on a stable layout plus
            imePadding insets. http:// links still render: LinkedText only
            displays them, never fetches. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.SinglenoteWidgetReceiver"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/singlenote_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NoteChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.yungsamd17.singlenote.NOTE_UPDATED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notify.PinActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.PinBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- App updates also wipe notifications: re-post the pin
                    without waiting for the next app open. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tile.NoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
    </application>

</manifest>
